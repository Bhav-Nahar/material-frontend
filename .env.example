# Frontend env template. Copy to .env.local for local dev; paste the same keys into
# Vercel > Settings > Environment Variables for deploys.
#
# Only the vars the code actually reads are listed. Razorpay keys, Shopify OAuth client
# credentials and the webhook secret belong to material-backend ONLY -- the browser never
# sends an amount and this app never signs a payment, so duplicating them here just widens
# the blast radius of a leak.

# Public origin of THIS app. Used by sitemap/robots and canonical URLs, so a wrong value
# publishes wrong URLs to search engines. On Vercel set the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# material-backend. Owns OTP auth, Razorpay and prizes. No trailing slash.
# Local: http://127.0.0.1:8080  Deployed: https://<service>.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080

# Storefront API. NEXT_PUBLIC_* is absent on purpose: these run server-side only.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-01

# Admin API, for the review-photo uploads in src/lib/shopify-files.js.
SHOPIFY_ADMIN_TOKEN=

# Judge.me, server-side only (src/lib/reviews.js).
JUDGEME_PRIVATE_TOKEN=

# Optional. Unset disables GTM rather than loading a broken container.
NEXT_PUBLIC_GTM_ID=
